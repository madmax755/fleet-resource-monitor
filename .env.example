# Copy to .env next to docker-compose.yml on the Pi.

# ntfy (self-hosted)
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=fleet-resources
# NTFY_TOKEN=tk_xxxxxxxx

# Paths inside the container (compose mounts these)
HOSTS_FILE=/config/hosts.yml
STATE_FILE=/data/state.json
HEARTBEAT_FILE=/data/heartbeat
SSH_IDENTITY_FILE=/ssh/id_ed25519
SSH_KNOWN_HOSTS=/ssh/known_hosts

# Timing
CHECK_INTERVAL_SECONDS=900
# Re-alert while still unhealthy (default 6 hours)
ALERT_COOLDOWN_SECONDS=21600
SSH_CONNECT_TIMEOUT=10

# Thresholds
DISK_WARN_PERCENT=85
DISK_CRITICAL_PERCENT=92
RAM_CRITICAL_PERCENT=90
LOAD_MULTIPLIER=2
LOAD_CONSECUTIVE_REQUIRED=2

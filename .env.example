# Copy to .env next to docker-compose.yml on the Pi.

# ntfy (self-hosted)
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=fleet-resources
# NTFY_TOKEN=tk_xxxxxxxx

# Paths inside the container (compose mounts these)
HOSTS_FILE=/config/hosts.yml
STATE_FILE=/data/state.json
HEARTBEAT_FILE=/data/heartbeat
SSH_IDENTITY_FILE=/ssh/id_ed25519
SSH_KNOWN_HOSTS=/ssh/known_hosts

# Timing
CHECK_INTERVAL_SECONDS=900
# Re-alert while still unhealthy (default 6 hours)
ALERT_COOLDOWN_SECONDS=21600
SSH_CONNECT_TIMEOUT=10

# Thresholds
DISK_WARN_PERCENT=85
DISK_CRITICAL_PERCENT=92
RAM_CRITICAL_PERCENT=90
LOAD_MULTIPLIER=2
TEMP_WARN_CELSIUS=70
TEMP_CRITICAL_CELSIUS=80

# Consecutive confirmation (both alert and recovery). At the default 15m
# interval, 2 ≈ ~30m before first page / clear. Damps ephemeral flaps.
# Temperature defaults to 1 so a single hot reading can page (thermal runaway
# is too fast to wait for two checks).
DISK_CONSECUTIVE_REQUIRED=2
RAM_CONSECUTIVE_REQUIRED=2
LOAD_CONSECUTIVE_REQUIRED=2
TEMP_CONSECUTIVE_REQUIRED=1
UNREACHABLE_CONSECUTIVE_REQUIRED=2
